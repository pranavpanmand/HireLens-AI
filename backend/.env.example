# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database + sessions (required — the server refuses to boot without these)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/career-compass-ai
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Cloudinary (required) — resume files, profile photos, video resumes
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------------------------------------------------------------------------
# AI + job aggregation
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# Leave these blank to run with email/password auth only — the Google button is
# hidden and POST /api/auth/google answers 503.
#
# To enable: Firebase console > Project settings > Service accounts >
# "Generate new private key". Copy the three values out of the downloaded JSON.
#
# FIREBASE_PRIVATE_KEY must keep its literal \n sequences and stay in quotes.
# NEVER commit the real values — this key can mint tokens for your project.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Email / SMTP (optional) — password reset + job alert digests.
# Without SMTP_HOST and SMTP_USER the email service no-ops instead of failing.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
